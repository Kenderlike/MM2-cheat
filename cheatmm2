local function applyHighlight(target, color, enabled, nameTag)
	if not target then return end
	local highlight = target:FindFirstChild(nameTag or "MM2_ESP_Highlight")

	if enabled then
		if not highlight then
			highlight = Instance.new("Highlight")
			highlight.Name = nameTag or "MM2_ESP_Highlight"
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.FillTransparency = 0.55
			highlight.OutlineTransparency = 0
			highlight.Parent = target
		end
		highlight.FillColor = color
		highlight.OutlineColor = color
		highlight.Enabled = true
	else
		if highlight then
			highlight:Destroy()
		end
	end
end

local function getPlayerRole(player)
	local backpack = player:FindFirstChild("Backpack")
	local character = player.Character

	local hasKnife = (backpack and (backpack:FindFirstChild("Knife") or backpack:FindFirstChild("KnifeClient"))) or 
					 (character and (character:FindFirstChild("Knife") or character:FindFirstChild("KnifeClient")))
					 
	local hasGun = (backpack and (backpack:FindFirstChild("Gun") or backpack:FindFirstChild("Revolver"))) or 
				   (character and (character:FindFirstChild("Gun") or character:FindFirstChild("Revolver")))

	if hasKnife then return "Murderer" end
	if hasGun then return "Sheriff" end
	return "Innocent"
end

local function getDroppedGun()
	local g = Workspace:FindFirstChild("GunDrop")
	if g then return g end
	
	for _, v in ipairs(Workspace:GetChildren()) do
		if v:IsA("Model") or v:IsA("Folder") then
			g = v:FindFirstChild("GunDrop")
			if g then return g end
		end
	end
	return nil
end

local function getCoinContainer()
	local cc = Workspace:FindFirstChild("CoinContainer")
	if cc then return cc end
	for _, v in ipairs(Workspace:GetChildren()) do
		if v:IsA("Model") or v:IsA("Folder") then
			cc = v:FindFirstChild("CoinContainer")
			if cc then return cc end
		end
	end
	return nil
end

task.spawn(function()
	while task.wait(0.5) do
		local tempMurderer = nil
		cachedDroppedGun = getDroppedGun()

		if espEnabled then
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
					local role = getPlayerRole(player)
					if role == "Murderer" then tempMurderer = player end
					
					local ch = player.Character
					if role == "Murderer" then
						applyHighlight(ch, Color3.fromRGB(255, 60, 60), espSettings.murder)
					elseif role == "Sheriff" then
						applyHighlight(ch, ACCENT2, espSettings.sheriff)
					elseif role == "Innocent" then
						applyHighlight(ch, GREEN, espSettings.innocent)
					end
				end
			end
			cachedMurderer = tempMurderer

			if cachedDroppedGun then
				local targetHighlight = (cachedDroppedGun:IsA("Tool") and cachedDroppedGun:FindFirstChild("Handle")) or cachedDroppedGun
				applyHighlight(targetHighlight, Color3.fromRGB(255, 200, 60), espSettings.gun, "MM2_Gun_Highlight")
				
				if espSettings.gun then
					local arrow = targetHighlight:FindFirstChild("MM2_Gun_Arrow")
					if not arrow then
						arrow = Instance.new("Folder")
						arrow.Name = "MM2_Gun_Arrow"
						
						local tip = Instance.new("ConeHandleAdornment")
						tip.Name = "Tip"
						tip.Radius = 1
						tip.Height = 2
						tip.Color3 = Color3.fromRGB(255, 200, 60)
						tip.Transparency = 0.2
						tip.AlwaysOnTop = true
						tip.ZIndex = 10
						tip.Adornee = targetHighlight
						tip.Parent = arrow
						
						local shaft = Instance.new("CylinderHandleAdornment")
						shaft.Name = "Shaft"
						shaft.Radius = 0.4
						shaft.Height = 3.5
						shaft.Color3 = Color3.fromRGB(255, 200, 60)
						shaft.Transparency = 0.2
						shaft.AlwaysOnTop = true
						shaft.ZIndex = 10
						shaft.Adornee = targetHighlight
						shaft.Parent = arrow
						
						arrow.Parent = targetHighlight
					end
				else
					local arrow = targetHighlight:FindFirstChild("MM2_Gun_Arrow")
					if arrow then arrow:Destroy() end
				end
			end
		else
			for _, player in ipairs(Players:GetPlayers()) do
				if player.Character then applyHighlight(player.Character, nil, false) end
			end
			if cachedDroppedGun then 
				local targetHighlight = (cachedDroppedGun:IsA("Tool") and cachedDroppedGun:FindFirstChild("Handle")) or cachedDroppedGun
				applyHighlight(targetHighlight, nil, false, "MM2_Gun_Highlight") 
				local arrow = targetHighlight:FindFirstChild("MM2_Gun_Arrow")
				if arrow then arrow:Destroy() end
			end
			
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and player.Character then
					if getPlayerRole(player) == "Murderer" then tempMurderer = player end
				end
			end
			cachedMurderer = tempMurderer
		end

		local container = getCoinContainer()
		if container then
			for _, coin in ipairs(container:GetChildren()) do
				local isCoin = string.find(coin.Name, "Coin") or string.find(coin.Name, "Snowflake") or string.find(coin.Name, "Candy")
				if isCoin then
					local part = coin:IsA("BasePart") and coin or coin:FindFirstChildWhichIsA("BasePart")
					if part then
						local adorn = part:FindFirstChild("MM2_Coin_ESP")
						if espEnabled and espSettings.coins then
							if not adorn then
								adorn = Instance.new("SphereHandleAdornment")
								adorn.Name = "MM2_Coin_ESP"
								adorn.Radius = (part.Size.Magnitude / 2) * 1.2
								adorn.Color3 = Color3.fromRGB(255, 255, 0)
								adorn.AlwaysOnTop = true
								adorn.ZIndex = 5
								adorn.Transparency = 0.5
								adorn.Adornee = part
								adorn.Parent = part
							end
						else
							if adorn then adorn:Destroy() end
						end
					end
				end
			end
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if espEnabled and espSettings.gun and cachedDroppedGun then
		local targetHighlight = (cachedDroppedGun:IsA("Tool") and cachedDroppedGun:FindFirstChild("Handle")) or cachedDroppedGun
		local arrow = targetHighlight:FindFirstChild("MM2_Gun_Arrow")
		if arrow and arrow:FindFirstChild("Tip") and arrow:FindFirstChild("Shaft") then
			local bob = math.sin(tick() * 5) * 1.5 + 5
			arrow.Tip.CFrame = CFrame.new(0, bob, 0) * CFrame.Angles(-math.pi/2, 0, 0)
			arrow.Shaft.CFrame = CFrame.new(0, bob + 1.75, 0) * CFrame.Angles(math.pi/2, 0, 0)
		end
	end
	
	local character = LocalPlayer.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			if speedEnabled then
				humanoid.WalkSpeed = BASE_SPEED * speedMult
			else
				if humanoid.WalkSpeed > BASE_SPEED then
					humanoid.WalkSpeed = BASE_SPEED
				end
			end
		end
	end
end)

RunService.Stepped:Connect(function()
	if noclipEnabled then
		local char = LocalPlayer.Character
		if char then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") and part.CanCollide then
					part.CanCollide = false
				end
			end
		end
	end
end)

UIS.JumpRequest:Connect(function()
	if infJumpEnabled then
		local char = LocalPlayer.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
	end
end)

