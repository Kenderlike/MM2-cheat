		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		ZIndex = 3,
	})
	corner(knob, 9)
	stroke(knob, ACCENT, 2)

	local function setSpeedFromX(x)
		x = math.clamp(x, 0, 1)
		knob.Position = UDim2.fromScale(x, 0.5)
		fill.Size = UDim2.fromScale(x, 1)
		
		speedMult = math.floor((1 + x * 4) * 10) / 10
		speedLabel.Text = ("Скорость: %.1fx"):format(speedMult)
	end

	local function updateFromMouse()
		local mx = UIS:GetMouseLocation().X
		local bx = bar.AbsolutePosition.X
		local bw = bar.AbsoluteSize.X
		if bw > 0 then
			setSpeedFromX((mx - bx) / bw)
		end
	end

	local isSliderDragging = false

	bar.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			isSliderDragging = true
			updateFromMouse()
		end
	end)

	UIS.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			isSliderDragging = false
		end
	end)

	UIS.InputChanged:Connect(function(inp)
		if isSliderDragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
			updateFromMouse()
		end
	end)
end)

