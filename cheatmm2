local tabFrames = {}
local function addTab(label, build)
	local b = mk("TextButton", tabBar, {
		Size = UDim2.fromScale(1 / 4, 1),
		Position = UDim2.fromScale((#tabBtns) * (1 / 4), 0),
		BackgroundColor3 = CARD,
		BackgroundTransparency = 0,
		AutoButtonColor = true,
		Text = label,
		TextColor3 = SUBT,
		TextSize = 12,
		Font = Enum.Font.GothamBold,
	})
	corner(b, 8)
	table.insert(tabBtns, b)

	local f = mk("Frame", body, {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Visible = (#tabFrames == 0),
	})
	table.insert(tabFrames, f)
	if build then build(f) end

	b.Activated:Connect(function()
		for i, tf in ipairs(tabFrames) do
			local isActive = (tf == f)
			tf.Visible = isActive
			local tb = tabBtns[i]
			if tb then
				if isActive then
					TweenService:Create(tb, TweenInfo.new(0.12), { BackgroundColor3 = ACCENT, TextColor3 = Color3.fromRGB(255, 255, 255) }):Play()
				else
					TweenService:Create(tb, TweenInfo.new(0.12), { BackgroundColor3 = CARD, TextColor3 = SUBT }):Play()
				end
			end
		end
	end)
	return #tabFrames
end

