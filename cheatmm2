		Text = text,
		TextColor3 = TEXT,
		TextSize = 13,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local switch = mk("TextButton", row, {
		Size = UDim2.fromOffset(44, 22),
		Position = UDim2.new(1, -9, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = OFFBG,
		AutoButtonColor = false,
		Text = "",
	})
	corner(switch, 11)
	local knob = mk("Frame", switch, {
		Size = UDim2.fromOffset(18, 18),
		Position = UDim2.fromOffset(2, 2),
		BackgroundColor3 = Color3.fromRGB(220, 220, 228),
	})
	corner(knob, 9)

	local state = default
	local function setState(v)
		state = v
		if v then
			knob:TweenPosition(UDim2.fromOffset(24, 2), "Out", "Quad", 0.12, true)
			TweenService:Create(switch, TweenInfo.new(0.12), { BackgroundColor3 = GREEN }):Play()
		else
			knob:TweenPosition(UDim2.fromOffset(2, 2), "Out", "Quad", 0.12, true)
			TweenService:Create(switch, TweenInfo.new(0.12), { BackgroundColor3 = OFFBG }):Play()
		end
		if onChanged then onChanged(v) end
	end
	switch.Activated:Connect(function()
		setState(not state)
	end)
	setState(default)
	return setState
end

