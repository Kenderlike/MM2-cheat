local autoFarmCoins = false
local currentTween = nil
local noclipConnectionAF = nil
local threatConnectionAF = nil

local dangerRadius = 10     
local safeCoinRadius = 15   
local maxValidDistance = 800 
local ignoredCoins = {}

local function getClosestSafeCoin(hrp, container, murderer)
	local closestCoin = nil
	local shortestDistance = math.huge

	for _, coin in ipairs(container:GetChildren()) do
		if not ignoredCoins[coin] then
			local isCoin = string.find(coin.Name, "Coin") or string.find(coin.Name, "Snowflake") or string.find(coin.Name, "Candy")
			if isCoin then
				local part = coin:IsA("BasePart") and coin or coin:FindFirstChildWhichIsA("BasePart", true)
				if part then
					local distance = (hrp.Position - part.Position).Magnitude
					
					if distance <= maxValidDistance then
						local isSafe = true
						if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
							local mHrp = murderer.Character.HumanoidRootPart
							local distToMurderer = (part.Position - mHrp.Position).Magnitude
							if distToMurderer < safeCoinRadius then
								isSafe = false
							end
						end
						
						if isSafe and distance < shortestDistance then
							shortestDistance = distance
							closestCoin = coin
						end
					end
				else
					ignoredCoins[coin] = true
				end
			end
		end
	end
	return closestCoin
end

local function startFarmingLoop()
	task.spawn(function()
		while autoFarmCoins do
			task.wait(0.1)
			
			local char = LocalPlayer.Character
			if char and char:FindFirstChild("HumanoidRootPart") then
				local hrp = char.HumanoidRootPart
				
				local container = getCoinContainer()
				if not container or #container:GetChildren() == 0 then
					task.wait(1)
				else
					local coin = getClosestSafeCoin(hrp, container, cachedMurderer)
					
					if not coin then 
						task.wait(1) 
					else
						local part = coin:IsA("BasePart") and coin or coin:FindFirstChildWhichIsA("BasePart", true)
						
						if part then 
							local distance = (hrp.Position - part.Position).Magnitude
							local safeSpeed = 20 
							local tweenTime = distance / safeSpeed
							
							local tweenInfo = TweenInfo.new(tweenTime, Enum.EasingStyle.Linear)
							currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = part.CFrame})
							
							noclipConnectionAF = RunService.Stepped:Connect(function()
								for _, p in ipairs(char:GetDescendants()) do
									if p:IsA("BasePart") and p.CanCollide then
										p.CanCollide = false
									end
								end
							end)
							
							threatConnectionAF = RunService.Heartbeat:Connect(function()
								if cachedMurderer and cachedMurderer.Character and cachedMurderer.Character:FindFirstChild("HumanoidRootPart") then
									local distToMe = (hrp.Position - cachedMurderer.Character.HumanoidRootPart.Position).Magnitude
									if distToMe < dangerRadius then
										if currentTween then currentTween:Cancel() end
									end
								end
							end)
							
							currentTween:Play()
							currentTween.Completed:Wait() 
							
							if noclipConnectionAF then noclipConnectionAF:Disconnect() end
							if threatConnectionAF then threatConnectionAF:Disconnect() end
							
							if not autoFarmCoins then break end 
							
							if (hrp.Position - part.Position).Magnitude < 5 then
								if firetouchinterest then
									firetouchinterest(hrp, part, 0)
									task.wait(0.01)
									firetouchinterest(hrp, part, 1)
								end
								ignoredCoins[coin] = true
							end
						else
							ignoredCoins[coin] = true 
						end
					end
				end
			end
		end
	end)
end

local automationTab = addTab("Автоматизация", function(f)
	vlist(f, 8)
	
	makeToggle(f, "Автофарм монет", false, function(v)
		autoFarmCoins = v
		if autoFarmCoins then
			startFarmingLoop()
		else
			if currentTween then currentTween:Cancel() end
			if noclipConnectionAF then noclipConnectionAF:Disconnect() end
			if threatConnectionAF then threatConnectionAF:Disconnect() end
		end
	end)
end)

